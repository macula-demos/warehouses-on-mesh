<Layouts.app flash={@flash}>
  <div class="space-y-8">
    <section class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.2em] text-emerald-300">
            <span class="size-1.5 rounded-full bg-emerald-400"></span> Mesh path
          </span>
          <span class="text-[10px] uppercase tracking-[0.25em] text-slate-500">
            2 sites · 2 federated stations
          </span>
        </div>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
          Two warehouses, one mesh
        </h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-400">
          Site A reads and commands site B through a federated station relay. Both gateways dial
          out; neither site has an inbound port. The browser only talks to this local app.
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:items-end">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/80 px-4 py-3 text-right shadow-lg shadow-black/20">
          <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500">Operator node</p>
          <p class="mt-1 font-mono text-sm text-cyan-200" title={@operator_node_id || ""}>
            {short_id(@operator_node_id)}
          </p>
        </div>
        <p class="text-xs text-slate-500">
          Last refresh {format_time(@snapshot.last_refresh_ms)} · {length(@selected_freezers)} freezers
          on {site_label(@selected_site)}
        </p>
      </div>
    </section>

    <%= if @error do %>
      <div class="flex items-start gap-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-100">
        <.icon name="hero-exclamation-triangle" class="mt-0.5 size-5 shrink-0 text-amber-300" />
        <div>
          <p class="font-medium">The mesh is not ready</p>
          <p class="mt-1 text-amber-100/70">{format_reason(@error)}</p>
          <p class="mt-2 text-xs text-amber-100/50">
            The local mesh client retries every second. Check both stations, the realm fixture,
            and both gateways.
          </p>
        </div>
      </div>
    <% end %>

    <section class="grid gap-4 lg:grid-cols-[1fr_0.8fr_1fr]">
      <.site_card
        site_id="A"
        provider={short_id(Map.get(@sites, "A", %{})[:provider])}
        station={short_id(Map.get(@station_ids, "A"))}
        freezers={Map.get(@sites, "A", %{})[:freezers] || []}
        selected?={@selected_site == "A"}
      />

      <article class="flex flex-col justify-between rounded-2xl border border-cyan-500/20 bg-gradient-to-b from-cyan-500/10 to-slate-900/60 p-4">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-cyan-300/80">
            Federated relay
          </p>
          <span class="size-2 animate-pulse rounded-full bg-cyan-300"></span>
        </div>
        <div class="mt-5 space-y-2 text-sm">
          <p class="font-mono text-xs text-cyan-100">station A ⟷ station B</p>
          <p class="text-xs leading-5 text-slate-400">
            Discovery crosses the station link. A site B call is sent to station A and forwarded
            to station B; the payload stays sealed end to end.
          </p>
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-cyan-500/10 pt-3 text-[10px] uppercase tracking-[0.18em] text-cyan-200/60">
          <span>no inbound port</span>
          <span>ciphertext only</span>
        </div>
      </article>

      <.site_card
        site_id="B"
        provider={short_id(Map.get(@sites, "B", %{})[:provider])}
        station={short_id(Map.get(@station_ids, "B"))}
        freezers={Map.get(@sites, "B", %{})[:freezers] || []}
        selected?={@selected_site == "B"}
      />
    </section>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <.posture_card
        title="Exposure"
        value="no inbound port"
        tone={:success}
        detail="Each gateway dials out to its own station. The controllers are only on their site networks."
      />
      <.posture_card
        title="Authentication"
        value="operator node"
        tone={:success}
        detail="Reads stay open. Writes are authorized by the operator's node identity; the browser never holds the key."
      />
      <.posture_card
        title="Sealing"
        value="sealed: 1"
        tone={:success}
        detail="Every call is sealed to the gateway's KEM key. The station sees routing metadata and ciphertext."
      />
      <.posture_card
        title="Relay"
        value="A → B"
        tone={:success}
        detail="The site B call report names the site B provider; station A forwarded the call to station B."
      />
    </section>

    <section>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-lg font-semibold text-white">
              {site_label(@selected_site)} freezers
            </h2>
            <span class={[
              "rounded-full border px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider",
              site_badge(@selected_site)
            ]}>
              {site_path(@selected_site)}
            </span>
          </div>
          <p class="mt-1 text-sm text-slate-400">
            <%= if @selected_site == "B" do %>
              Reached through station A → station B. The call report below is sealed to the site B
              gateway.
            <% else %>
              The local path: browser → local app → station A → gateway A. No controller port is
              published.
            <% end %>
          </p>
        </div>
        <div class="text-right text-xs text-slate-500">
          <p>Last call</p>
          <p class="mt-1 font-mono text-[11px] text-emerald-200/80">
            {format_report(@last_report)}
          </p>
        </div>
      </div>

      <div id="freezers" phx-update="stream" class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div :for={{dom_id, freezer} <- @streams.freezers} id={dom_id}>
          <.freezer_card
            freezer={freezer}
            readings={Map.get(@readings, freezer["id"], [])}
            writes_enabled?={@mesh_ready? and @selected_freezers != []}
          />
        </div>
        <div
          id="freezers-empty"
          class="hidden only:block col-span-full rounded-2xl border border-dashed border-slate-800 bg-slate-900/30 p-6 text-sm text-slate-400"
        >
          Waiting for the {site_label(@selected_site)} provider to advertise. The dashboard
          resolves both gateways through the same station and picks by provider node id.
        </div>
      </div>
    </section>

    <section class="grid gap-4 lg:grid-cols-2">
      <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-sm font-semibold text-white">Providers</h2>
            <p class="mt-1 text-xs leading-5 text-slate-400">
              Both gateways advertise the same <code class="rounded bg-black/30 px-1">ot/*</code>
              procedures. The dashboard resolves both and picks by provider node id; two providers
              is the federation beat, not a duplicate.
            </p>
          </div>
          <span class="rounded-full border border-slate-700 bg-slate-800 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-slate-300">
            {length(@providers)} providers
          </span>
        </div>

        <div class="mt-4 overflow-hidden rounded-xl border border-slate-800">
          <table class="min-w-full divide-y divide-slate-800 text-left text-xs">
            <thead class="bg-slate-900/80 text-[10px] uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-3 py-2 font-medium">Provider</th>
                <th class="px-3 py-2 font-medium">Serving station</th>
                <th class="px-3 py-2 font-medium">Site</th>
                <th class="px-3 py-2 font-medium">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80">
              <tr :if={@providers == []}>
                <td colspan="4" class="px-3 py-4 text-slate-500">
                  Resolving <code class="rounded bg-black/30 px-1">ot/list_freezers</code> through
                  station A…
                </td>
              </tr>
              <tr :for={provider <- @providers} class="text-slate-300">
                <td
                  class="px-3 py-2 font-mono text-[11px] text-slate-400"
                  title={provider.provider}
                >
                  {short_id(provider.provider)}
                </td>
                <td
                  class="px-3 py-2 font-mono text-[11px] text-slate-400"
                  title={provider.station}
                >
                  {short_id(provider.station)}
                </td>
                <td class="px-3 py-2">{provider.site || "—"}</td>
                <td class="px-3 py-2">
                  <span class={[
                    "rounded-full border px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider",
                    if(provider.status == "ok",
                      do: "border-emerald-500/20 bg-emerald-500/10 text-emerald-300",
                      else: "border-amber-500/20 bg-amber-500/10 text-amber-200"
                    )
                  ]}>
                    {provider.status || "resolving"}
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </article>

      <article class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-sm font-semibold text-emerald-100">Refusals and replay</h2>
            <p class="mt-1 max-w-xl text-xs leading-5 text-emerald-200/60">
              The same gateway policy as part 1, now across the relay. Replay re-sends the previous
              command id; the stranger is a second node identity on station A, not on either
              gateway's operator list.
            </p>
          </div>
          <.icon name="hero-shield-check" class="size-5 text-emerald-300/80" />
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <button
            phx-click="replay_last"
            disabled={!@mesh_ready?}
            class="rounded-xl border border-emerald-400/20 bg-emerald-500/10 px-3 py-2 text-xs font-medium text-emerald-100 transition hover:bg-emerald-500/20 disabled:cursor-not-allowed disabled:opacity-40"
          >
            Replay last command (should be refused)
          </button>
          <button
            phx-click="stranger_write"
            disabled={!@mesh_ready?}
            class="rounded-xl border border-amber-400/20 bg-amber-500/10 px-3 py-2 text-xs font-medium text-amber-100 transition hover:bg-amber-500/20 disabled:cursor-not-allowed disabled:opacity-40"
          >
            Try as stranger on site B (should be refused)
          </button>
        </div>
        <p class="mt-3 text-[11px] leading-5 text-emerald-200/50">
          Replay: <code class="rounded bg-black/30 px-1">command_replayed</code>. Stranger: <code class="rounded bg-black/30 px-1">unauthorized</code>, refused before the handler.
        </p>
        <p
          :if={@last_action}
          class="mt-3 rounded-lg border border-slate-700 bg-slate-800/60 px-3 py-2 text-[11px] text-slate-300"
        >
          {if is_binary(@last_action) and String.starts_with?(@last_action, "Command refused"),
            do: @last_action,
            else: "Last action: #{@last_action}"}
        </p>
      </article>
    </section>

    <section>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-white">
            Gateway {if @selected_site == "B", do: "B", else: "A"} audit
          </h2>
          <p class="mt-1 text-sm text-slate-400">
            Commands the gateway processed, with the wire-verified operator node and the command
            id. The controller only sees the gateway's own account.
          </p>
        </div>
        <div class="text-xs text-slate-500">{length(@selected_audit)} entries</div>
      </div>

      <div class="mt-4 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60">
        <table class="min-w-full divide-y divide-slate-800 text-left text-sm">
          <thead class="bg-slate-900/80 text-[10px] uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3 font-medium">Time</th>
              <th class="px-4 py-3 font-medium">Caller</th>
              <th class="px-4 py-3 font-medium">Action</th>
              <th class="px-4 py-3 font-medium">Freezer</th>
              <th class="px-4 py-3 font-medium">Command</th>
              <th class="px-4 py-3 font-medium">Result</th>
            </tr>
          </thead>
          <tbody id="gateway-audit" phx-update="stream" class="divide-y divide-slate-800/80">
            <tr
              :for={{dom_id, entry} <- @streams.gateway_audit}
              id={dom_id}
              class="text-slate-300"
            >
              <td class="whitespace-nowrap px-4 py-3 text-slate-400">
                {format_time(entry["at_ms"])}
              </td>
              <td class="px-4 py-3 font-mono text-xs text-slate-400" title={entry["caller"]}>
                {short_id(entry["caller"])}
              </td>
              <td class="px-4 py-3">{entry["action"]}</td>
              <td class="px-4 py-3">{entry["freezer_id"] || "—"}</td>
              <td class="px-4 py-3 font-mono text-xs text-slate-400" title={entry["command_id"]}>
                {short_id(entry["command_id"])}
              </td>
              <td class="px-4 py-3">{entry["result"]}</td>
            </tr>
          </tbody>
        </table>
        <p :if={@selected_audit == []} class="px-4 py-6 text-sm text-slate-500">
          No commands on this site yet. Use a freezer preset in Mesh mode.
        </p>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-white">Controller side</h2>
          <p class="mt-1 max-w-3xl text-xs leading-5 text-slate-400">
            Each controller's own audit shows only the gateway's
            <code class="rounded bg-black/30 px-1">gateway</code>
            account. The dashboard has no route to either controller; read the controller audit from
            its site network with <code class="rounded bg-black/30 px-1">./scripts/show-audits.sh</code>.
          </p>
        </div>
        <span class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1 text-[10px] font-medium uppercase tracking-wider text-slate-400">
          controller sees gateway only
        </span>
      </div>
    </section>
  </div>
</Layouts.app>
